# Admin auth — set these in .env.local, never commit real values

ADMIN_EMAIL=admin@aratanutra.com

# Preferred: bcrypt hash of the admin password. Generate one locally:
#   node -e "console.log(require('bcryptjs').hashSync('yourpass', 12))"
# Paste the printed $2a$... string here.
ADMIN_PASSWORD_HASH=

# Legacy plaintext fallback — only used when ADMIN_PASSWORD_HASH is unset.
# The auth layer prints a warning when it uses this path. Migrate to
# ADMIN_PASSWORD_HASH as soon as you can.
# ADMIN_PASSWORD=change-me-to-a-strong-passphrase

# NextAuth
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Razorpay Standard Checkout — get keys from https://dashboard.razorpay.com
#   Test keys: rzp_test_...
#   Live keys: rzp_live_...
# KEY_SECRET is server-only. NEVER prefix it with NEXT_PUBLIC_ or expose it to
# the client — it is used to sign orders and verify payment signatures.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# Razorpay Webhooks — generated per-webhook in the Razorpay dashboard
# (Settings → Webhooks → Add New Webhook). The secret you set on the
# webhook is what signs incoming payloads; paste the same value here so
# /api/razorpay/webhook can verify the HMAC-SHA256 signature.
RAZORPAY_WEBHOOK_SECRET=
